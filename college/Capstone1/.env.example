# AutoInspect-X — environment template
# Copy to .env and fill in locally. Never commit .env.

# --- Runtime ---
ENVIRONMENT=development
LOG_LEVEL=info

# --- API ---
# Base URL the frontend uses to reach the backend.
API_URL=http://localhost:8000

# --- LLM (Groq) ---
# Used for report summarisation / explanation text once the API exists.
# Keep the value in .env locally; never commit the real key.
GROQ_AUTO_INSPECT_API_KEY=

# --- Database ---
# No database exists for this project yet. Leave empty until one is provisioned.
#
# If Supabase is adopted, SUPABASE_URL determines which project this repository
# talks to. The project ref is the subdomain: https://<project-ref>.supabase.co
# Confirm the ref against the Supabase project list before using it.
# Do NOT point this at nykalxhmbupsarhicrtd — that project belongs to a
# different product (Physios Plus CRM V3).
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Model artefacts ---
# Path or registry URI for the segmentation model. Never hard-code these in code.
MODEL_PATH=
MODEL_VERSION=

# --- CORS ---
# JSON list of browser origins allowed to call the API (apps/web dev server).
CORS_ORIGINS=["http://localhost:3000"]

# --- Frontend (apps/web) ---
# Base URL the browser uses to reach the backend. Set this in apps/web/.env.local.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Automation ---
# Set only if an n8n workflow is actually wired up. See LOGIC.md.
N8N_WEBHOOK_URL=
